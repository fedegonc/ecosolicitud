        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="clasificar ganador/conflicto" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def body = prev.getResponseDataAsString() ?: ''
def code = prev.getResponseCode()
def label
if (code != '200') {
    label = "aceptar-HTTP_${code}"
} else if (body.contains('aceptada')) {
    label = 'aceptar-GANADOR'
} else if (body.contains('antes de tu acci')) {
    label = 'aceptar-CONFLICTO_VERSION'
} else if (body.contains('no admite esa acci')) {
    label = 'aceptar-INVALIDA'
} else if (body.contains('class="alerta"')) {
    label = 'aceptar-ALERTA_OTRA'
} else {
    label = 'aceptar-OTRO'
}
prev.setSampleLabel(label)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
